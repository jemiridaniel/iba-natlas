# Ibà on N-ATLAS. Copy to .env and fill the keys.
# All text generation goes to N-ATLaS (and the Ibà-ATLAS adapter) on an OpenAI-compatible vLLM:
#   vllm serve NCAIR1/N-ATLaS --enable-lora --max-lora-rank 16 \
#     --lora-modules iba-atlas=jemiridaniel/Iba-ATLAS-8B-LoRA-Powered-by-Awarri \
#     --dtype half --max-model-len 8192 --port 8000
APP_ENV=prod
CHAT_BASE_URL=http://localhost:8000/v1
# CHAT_API_KEY=            # only if your vLLM was started with --api-key
LLM_STRUCTURED_OUTPUT=json_schema
MODEL_FAST=NCAIR1/N-ATLaS
MODEL_MID=NCAIR1/N-ATLaS
MODEL_REASON=NCAIR1/N-ATLaS
MODEL_ATLAS=iba-atlas
# N-ATLaS is not a reasoning model and has an 8,192-token context window.
REASONING_REASON=false
MAX_TOKENS_REASONING_OFF=2048
LLM_TIMEOUT_S=120
PATIENT_EXPLANATION=true

# Guideline retrieval embeddings (not text generation): Nebius Token Factory by default,
# or EMBED_BASE_URL for another OpenAI-compatible embedding server.
NEBIUS_API_KEY=
MODEL_EMBED=Qwen/Qwen3-Embedding-8B
TAVILY_API_KEY=

# Self-hosted models cost nothing per token; the spend cap then only guards embeddings.
MODEL_PRICES={"NCAIR1/N-ATLaS": {"input": 0, "output": 0}, "iba-atlas": {"input": 0, "output": 0}, "Qwen/Qwen3-Embedding-8B": {"input": 0.01, "output": 0}}
MAX_SPEND_USD=1.0
